{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(py:*)",
      "Bash(pytest:*)",
      "Bash(pip:*)",
      "Bash(uvicorn:*)",
      "Bash(npm run:*)",
      "Bash(npm ci:*)",
      "Bash(npm install:*)",
      "Bash(npm ls:*)",
      "Bash(node:*)",
      "Bash(npx:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-remote:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(file:*)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -s http://127.0.0.1:*)",
      "Bash(curl -o /dev/null:*)",
      "Bash(netstat:*)",
      "Bash(ollama list:*)",
      "Bash(ollama ps:*)",
      "Bash(ollama show:*)",
      "Bash(docker ps:*)",
      "Bash(docker images:*)",
      "Bash(docker start:*)",
      "Bash(docker stop:*)",
      "Bash(docker exec:*)",
      "Bash(docker logs:*)",
      "Bash(tesseract:*)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(del:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(git branch -D:*)",
      "Bash(docker rm:*)",
      "Bash(docker rmi:*)",
      "Bash(docker volume rm:*)",
      "Bash(taskkill:*)",
      "Bash(winget uninstall:*)",
      "Bash(winget install:*)",
      "Bash(pip uninstall:*)",
      "Bash(npm uninstall:*)",
      "Bash(dropdb:*)",
      "Bash(psql:*)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)"
    ]
  }
}
