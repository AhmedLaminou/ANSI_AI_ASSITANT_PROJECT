# Application
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Authentication: replace before first start; never commit the real file.
JWT_SECRET=replace-with-a-long-random-value
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-local-password

# Local Ollama only. Do not change this to a public or cloud endpoint.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
# qwen3 emits its reasoning before the answer; the stream hides it until </think>.
# Set to false for a model that answers directly, so tokens stream immediately.
OLLAMA_CHAT_REASONING=true
# qwen3's "/no_think" soft switch. Only the hybrid Qwen3 models honour it: qwen3:4b is
# Qwen3-4B-Thinking-2507 and always reasons (docs/ARCHITECTURE_TECHNIQUE.md 5.8).
# To answer without reasoning, change the model instead:
#   OLLAMA_CHAT_MODEL=qwen3:4b-instruct-2507-q4_K_M and OLLAMA_CHAT_REASONING=false
OLLAMA_CHAT_NO_THINK=false

# Questions per minute and per account. 0 disables the limit.
CHAT_RATE_LIMIT_PER_MINUTE=12

# FAILED sign-in attempts tolerated, counted per account and per source address.
LOGIN_RATE_LIMIT_PER_MINUTE=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Access requests tolerated per source address per hour. /auth/register is the only
# unauthenticated write endpoint, so this is what stops it being flooded. 0 disables.
REGISTRATION_RATE_LIMIT_PER_HOUR=5

# Documents. A newly imported document is due for review by its owner after this many
# months (0: no review date). The web batch import accepts this many files at once;
# for a whole folder, use `python -m app.import_folder` on the server instead.
DOCUMENT_REVIEW_MONTHS=12
DOCUMENT_BATCH_MAX_FILES=50

# Two unanswered questions belong to the same gap above this cosine similarity.
# Measured on embeddinggemma, not guessed: 0.45 mixes topics, 0.80 groups nothing.
GAP_SIMILARITY_THRESHOLD=0.50

# Conversation retention. 0 keeps history indefinitely.
# This value is a governance decision: set it before handling real data.
CONVERSATION_RETENTION_DAYS=0

# Database. Empty means the local SQLite file (fine for the POC).
# PostgreSQL + pgvector, recommended once the corpus grows:
#   DATABASE_URL=postgresql+psycopg://ansi:CHANGE_ME@127.0.0.1:5433/ansi_ai
# Note: switching databases does not migrate already-indexed documents.
DATABASE_URL=

# Local OCR for scanned PDFs. Emptying TESSERACT_CMD disables OCR.
# The language files live in backend/data/tessdata (see docs).
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANGUAGES=fra+eng
OCR_DPI=300
OCR_MAX_PAGES=40

# Retrieval attempts: 2 allows one reformulation and retry when the first
# search is weak; 1 disables that branch of the decision graph.
MAX_RETRIEVAL_ATTEMPTS=2

# Seconds allowed for one generation. CPU inference on a loaded machine is slow;
# raise this before concluding the model is unavailable.
CHAT_TIMEOUT_SECONDS=300
